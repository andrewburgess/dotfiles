{{- if .iswork }}
export GITHUB_ACCESS_TOKEN={{ onepasswordRead "op://Private/GitHub/Tokens/packages" .opPersonal }}
export AWS_SESSION_TOKEN_TTL="7200s"
export AWS_VAULT_BIOMETRICS=true
{{ end -}}
export NODE_OPTIONS="$NODE_OPTIONS --max-old-space-size=8192 --openssl-legacy-provider"
export XDG_CONFIG_HOME=$HOME/.config

# If you come from bash you might have to change your $PATH.
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

{{- if and .iswork .iswsl }}
export AWS_VAULT_BACKEND=pass
{{- end }}

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export ZSH_COMPDUMP=$HOME/.cache/zsh/.zcompdump
